    "bee-queue": "^2.0.0",
    "bull": "^4.16.5",
    "bullmq": "^6.7.7",
    "elysia": "^1.4.32",
    "exact-mirror": "^0.2.9",
    "express": "^5.3.0",
    "fastify": "^5.12.8",
    "groupmq": "^1.1.0",
    "hono": "^4.13.19",
    "ioredis": "^5.11.1",
    "next": "^16.4.6",
    "react": "^19.3.1",
    "react-aria-components": "1.16.0",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
