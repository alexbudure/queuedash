{
  "name": "@queuedash/ui",
  "version": "4.0.1",
  "description": "The beautiful Queuedash React dashboard for Bull, BullMQ, Bee-Queue, and GroupMQ",
  "main": "./dist/main.js",
  "module": "./dist/main.mjs",
  "types": "./dist/main.d.ts",
  "files": [
    "dist",
    "!dist/src",
    "!dist/*.tsbuildinfo",
    "!dist/vite.config.d.ts*"
  ],
  "keywords": [
    "bull",
    "bee-queue",
    "queue",
    "bullmq",
    "groupmq",
    "dashboard"
  ],
  "scripts": {
    "build": "tsc && vite build && npx @tailwindcss/cli -i src/styles/global.css -o ./dist/styles.css && node scripts/scope-css.mjs && pnpm run build:types",
    "build:types": "dts-bundle-generator --project tsconfig.types.json --external-inlines @queuedash/api --no-banner -o dist/main.d.ts src/main.ts",
    "dev": "node scripts/dev.mjs",
    "tailwind": "npx @tailwindcss/cli -i src/styles/global.css -o ./dist/styles.css --watch",
    "lint": "oxlint --config ../../.oxlintrc.json --disable-nested-config .",
    "lint:fix": "oxlint --config ../../.oxlintrc.json --disable-nested-config --fix .",
    "format": "oxfmt --config ../../.oxfmtrc.json .",
    "format:check": "oxfmt --config ../../.oxfmtrc.json --check ."
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@internationalized/date": "3.12.0",
    "@lezer/highlight": "^1.2.5",
    "@queuedash/api": "workspace:*",
    "@react-types/button": "3.15.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "@tailwindcss/cli": "^4.2.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@tanstack/react-query": "^5.94.5",
    "@tanstack/react-table": "^8.21.3",
    "@trpc/client": "^11.14.1",
    "@trpc/react-query": "^11.14.1",
    "@trpc/server": "^11.14.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^4.3.4",
    "clsx": "^2.1.1",
    "cronstrue": "^3.14.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "dts-bundle-generator": "^9.5.1",
    "lucide-react": "^0.577.0",
    "postcss": "^8.5.8",
    "react": "^19.2.4",
    "react-aria-components": "1.16.0",
    "react-dom": "^19.2.4",
    "react-intersection-observer": "^10.0.3",
    "react-json-tree": "^0.20.0",
    "react-router": "^7.13.1",
    "recharts": "^3.8.0",
    "rollup-plugin-typescript-paths": "^1.5.0",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.2.2",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "vite": "^5.4.19",
    "zod": "^4.3.6"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
